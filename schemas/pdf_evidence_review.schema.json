{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paperazzi/pdf_evidence_review.schema.json",
  "title": "Paperazzi local AI PDF evidence review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_identity",
    "attempts",
    "final_status",
    "accepted_attempt",
    "attempt_count",
    "front_matter_status",
    "reference_status",
    "needs_ocr",
    "quality_notes"
  ],
  "properties": {
    "document_identity": {
      "type": "string",
      "minLength": 1
    },
    "pdf_path": {
      "type": ["string", "null"]
    },
    "prompt_version": {
      "type": ["string", "null"]
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt",
          "actor",
          "strategy",
          "decision",
          "problems",
          "notes"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "actor": {
            "type": "string",
            "enum": [
              "DETERMINISTIC",
              "LOCAL_AI_CONTROLLED",
              "OCR"
            ]
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "PASS",
              "ACCEPT_PARTIAL",
              "RETRY",
              "UNRESOLVED",
              "NEEDS_OCR"
            ]
          },
          "problems": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "strategy_parameters": {
            "type": "object",
            "additionalProperties": true
          },
          "notes": {
            "type": "string"
          },
          "output_hash": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "final_status": {
      "type": "string",
      "enum": [
        "PASS",
        "ACCEPT_PARTIAL",
        "UNRESOLVED",
        "NEEDS_OCR"
      ]
    },
    "accepted_attempt": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 3
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "text_source": {
      "type": ["string", "null"],
      "enum": [
        "PDF_NATIVE",
        "ZOTERO_FT_CACHE",
        "OCR",
        null
      ]
    },
    "front_matter_status": {
      "type": "string",
      "enum": [
        "GOOD",
        "PARTIAL",
        "NO_USEFUL_EVIDENCE",
        "UNRESOLVED"
      ]
    },
    "reference_status": {
      "type": "string",
      "enum": [
        "SEGMENTED",
        "RAW_SECTION_ONLY",
        "NO_REFERENCE_SECTION_FOUND",
        "UNRESOLVED"
      ]
    },
    "reference_parse_method": {
      "type": ["string", "null"]
    },
    "reference_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "needs_ocr": {
      "type": "boolean"
    },
    "quality_notes": {
      "type": "string"
    }
  }
}
